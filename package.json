{
  "name": "obsidian-storyteller",
  "version": "0.6.0",
  "description": "Block-based comic script drafter for Obsidian with Word export.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint src",
    "test": "node scripts/test.mjs",
    "test:e2e": "node tests/e2e/editor.e2e.js"
  },
  "keywords": [
    "obsidian",
    "comic",
    "script"
  ],
  "license": "MIT",
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@types/node": "^20.11.0",
    "esbuild": "^0.21.5",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.14.4",
    "puppeteer-core": "^23.11.1",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.71.1"
  },
  "dependencies": {
    "docx": "^9.0.0"
  }
}
