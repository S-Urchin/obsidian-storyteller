              "text": "Wide shot. A storm batters a lonely lighthouse on a black rock. One window glows."
            },
            {
              "id": "d002",
              "locked": false,
              "revision": false,
              "pinned": false,
              "notes": [],
              "typeId": "caption",
              "speaker": "",
              "modifier": "",
              "text": "Thirty years I kept the light."
            }
          ]
        },
